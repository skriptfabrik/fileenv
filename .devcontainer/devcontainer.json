{
    "name": "fileenv",
    "image": "mcr.microsoft.com/vscode/devcontainers/base:ubuntu-24.04",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:4": {
            "version": "latest"
        },
        "ghcr.io/devcontainers-extra/features/mise:1": {
            "version": "latest"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "github.copilot",
                "github.vscode-github-actions",
                "github.vscode-pull-request-github",
                "hverlin.mise-vscode",
                "tamasfe.even-better-toml"
            ]
        }
    },
    "containerEnv": {
        "MISE_TRUSTED_CONFIG_PATHS": "${containerWorkspaceFolder}"
    },
    "remoteEnv": {
        "MISE_EXPERIMENTAL": "true",
        "MISE_LOCKFILE": "true"
    },
    "onCreateCommand": ".devcontainer/hooks/on-create.sh",
    "postCreateCommand": ".devcontainer/hooks/post-create.sh"
}